<!DOCTYPE html>
<html lang="cs">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Přihlášení</title>
	<style>
		body { font-family: Arial, sans-serif; background: #0f172a; color: #fff; padding: 24px; }
		.navbar, .card { max-width: 560px; margin: 0 auto 24px; }
		.navbar a { color: #60a5fa; margin-right: 16px; }
		.card { background: #1e293b; padding: 28px; border-radius: 12px; }
		label { display: block; margin-top: 16px; }
		input { width: 100%; box-sizing: border-box; padding: 12px; margin-top: 6px; border-radius: 6px; border: 1px solid #475569; }
		button { margin-top: 22px; padding: 12px 20px; border: 0; border-radius: 6px; background: #3b82f6; color: #fff; cursor: pointer; }
		.error { color: #fca5a5; }
	</style>
</head>
<body>
	<%- include('../partials/navigation') %>
	<main class="card">
		<h1>Přihlášení</h1>
		<% if (error) { %><p class="error"><%= error %></p><% } %>
		<form action="/auth/login" method="POST">
			<label for="email">E-mail</label>
			<input id="email" name="email" type="email" value="<%= email %>" required autocomplete="email">
			<label for="password">Heslo</label>
			<input id="password" name="password" type="password" required autocomplete="current-password">
			<button type="submit">Přihlásit se</button>
		</form>
		<p>Nemáte účet? <a href="/auth/register">Zaregistrujte se</a>.</p>
	</main>
</body>
</html>
