<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Moje Osobní Vizitka s Odpočtem</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #0f172a, #1e1b4b);
            color: #ffffff;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
        }

        .container {
            text-align: center;
            background: rgba(255, 255, 255, 0.05);
            padding: 40px 30px;
            border-radius: 20px;
            backdrop-filter: blur(10px);
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
            border: 1px solid rgba(255, 255, 255, 0.1);
            max-width: 350px;
            width: 100%;
        }

        .avatar {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            background: linear-gradient(45deg, #3b82f6, #8b5cf6);
            margin: 0 auto 20px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 40px;
            box-shadow: 0 0 20px rgba(139, 92, 246, 0.5);
        }

        h1 {
            font-size: 24px;
            margin: 0 0 10px 0;
            font-weight: 600;
        }

        p {
            color: #94a3b8;
            font-size: 14px;
            margin: 0 0 20px 0;
        }

        /* --- STYL PRO ODPOČET --- */
        .countdown-box {
            background: rgba(0, 0, 0, 0.2);
            padding: 15px;
            border-radius: 12px;
            margin-bottom: 30px;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .countdown-title {
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #3b82f6;
            margin-bottom: 5px;
        }

        .countdown-timer {
            font-size: 20px;
            font-weight: bold;
            font-family: monospace;
            color: #10b981;
        }
        /* ------------------------ */

        .links {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .link-btn {
            display: block;
            padding: 12px;
            color: #ffffff;
            text-decoration: none;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            transition: all 0.3s ease;
            font-weight: 500;
            border: 1px solid transparent;
        }

            .link-btn:hover {
                background: #ffffff;
                color: #0f172a;
                transform: translateY(-3px);
                box-shadow: 0 5px 15px rgba(255, 255, 255, 0.2);
            }
    </style>
</head>
<body>

    <div class="container">
        <div class="avatar">⏳</div>

        <h1>Ahoj, já jsem Vývojář!</h1>
        <p>Vítejte na mém prvním Express serveru.</p>

        <!-- Nový box pro odpočet -->
        <div class="countdown-box">
            <div class="countdown-title">Čas do Nového roku:</div>
            <div id="timer" class="countdown-timer">Načítání...</div>
        </div>

        <div class="links">
            <a href="https://github.com" target="_blank" class="link-btn">Můj GitHub</a>
            <a href="https://instagram.com" target="_blank" class="link-btn">Instagram</a>
            <a href="https://linkedin.com" target="_blank" class="link-btn">LinkedIn</a>
        </div>
    </div>

    <!-- SKRIPT PRO LOGIKU ODPOČTU -->
    <script>// Nastavení cílového data (zde Nový rok)
        const currentYear = new Date().getFullYear();
        const targetDate = new Date(`January 1, ${currentYear + 1} 00:00:00`).getTime();

        function updateCountdown() {
            const now = new Date().getTime();
            const difference = targetDate - now;

            // Výpočet dnů, hodin, minut a sekund
            const days = Math.floor(difference / (1000 * 60 * 60 * 24));
            const hours = Math.floor((difference % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((difference % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((difference % (1000 * 60)) / 1000);

            // Zobrazení výsledku v HTML elementu s id="timer"
            const timerElement = document.getElementById("timer");

            if (difference < 0) {
                clearInterval(intervalId);
                timerElement.innerHTML = "Šťastný nový rok! 🎉";
            } else {
                timerElement.innerHTML = `${days}d ${hours}h ${minutes}m ${seconds}s`;
            }
        }

        // Spustit odpočet hned a pak každou sekundu (1000 ms)
        updateCountdown();
        const intervalId = setInterval(updateCountdown, 1000);</script>

</body>
</html>
